{ ===========================================================================
  Psycho Neurosis (Asphyxia, 1994) -- NEUROSIS.005 scene 3, segment 1102.

  A 30 x 30 patch of a loaded picture, lifted into three dimensions and turned
  about one axis while the patch itself wanders around the picture and bounces
  off its edges. Each point is drawn in its own colour, and the pixel VALUE is
  added to the projected Y -- so the brighter a pixel, the further down the
  screen it lands, and the picture becomes a relief.

  Read from the binary instruction by instruction; nothing here is inferred.
  See docs/26-part5-notes.md for the reading.

  ADDRESS MAP
    RenderPatch     1102:0000     Demo_Scene3     1102:035a
    Scene3_Run      1102:017e     (unit init)     1102:038c
    Setup           1102:02d1
    FixMul          1102:0391     SinCos          1102:11d9
    FixDiv          1102:03a5     RotatePoint     1102:128b
    the cosine table at CS:$03C5   Project         1102:13d9

  THE MATHS IS THE SAME OBJECT PARTS 001 AND 002 LINK. `SinCos`,
  `RotatePoint` and `Project` here are byte-identical to part 001's copies at
 -- 16, 24 and 7 bytes differ across the
  three and every one of them is a DGROUP or table displacement. The table at
  CS:$03C5 is the same 901 entries of Round(cos(i/10 degrees) * 65536).

  It also showed that the module has FIVE routines and not three: FixMul at
 and FixDiv at 1102:03a5 sit ahead of the table in both binaries.
  Neither is called from Pascal in any part read so far -- they survive the
  link because an external OBJ is linked whole, not per procedure -- but they
  are part of the module and are now in src/asm/DEMOMATH.ASM.

  DGROUP
 MCos1   DS:$a666  MSin1        DS:$a67a  MScale
 MCos2   DS:$a66e  MSin2        DS:$a67e  the picture, a Pointer
 MCos3   DS:$a676  MSin3        DS:$a682  its segment
 the palette, 768 bytes         DS:$a984  the file
 MViewH = 200   DS:$2d18  MViewW = 320  -- initialised data
  =========================================================================== }

{$S-}   { opens ENTER $26,0 with no stack check. }

unit P5PATCH;
{$I-}   { no I/O check: the original goes straight on after each file
          call, with no near CALL to the RTL's check routine. }
{$A-}   { data alignment off -- measured, see the note in P2SOLID.PAS }

{$G+}   { 286: RenderPatch 1102:0000 opens ENTER $26; the whole segment is
          ENTER-framed. }

interface

procedure Scene3;

implementation

uses Crt, VGA, FixMath;   { IntToFixed, 124a:0034 RealToFixed }

{$I gen/DATOFS.INC}   { NEUROSIS.DAT offsets and lengths, generated by
                        tools/mkdat.py from assets/NEUROSIS.MAN. Every
                        constant in it is UNTYPED, so including the whole
                        set costs no storage and changes no data image. }

const
  Patch    = 30;                  { the patch is 30 x 30 }
  DataOfs  = DAT_P5_PATCHPIC;   { $1646E5 -- 1102:030d pushes $0016 then $46E5 }
  ScaleR   = 1600.0;              { builds this Real in AX:BX:DX }
  DepthZ   = 200;
  LiftY    = -50;                 { pushes -$32 }
  YBias    = 500;                 { subtracts $1F4 }
  FullTurn = 3600;                { tenths of a degree }

type
  TPal768 = array[0..767] of Byte;
  { subtract using AX alone, so only the LOW word of
    the projected coordinate is ever looked at. }
  TLongRec = record Lo, Hi : Word end;

var
  { The six words the maths module reads. The order here is the order in the
    binary: 1102:0025 fills the pair at $a662 and 1102:0022 the pair at $a66a,
    so the ANGLE goes into the SECOND pair and the other two are zeroed. }
  MCos1, MSin1, MCos2, MSin2, MCos3, MSin3 : LongInt;
  MScale : LongInt;

  Pic    : Pointer;
  PicSeg : Word;
  Pal    : TPal768;
  F      : file;

const
  { initialised data. Project halves both, so these are
    the FULL view size and not the centre.

    DECLARED H FIRST, and the addresses are the whole reason: the original
    puts MViewH at $2d16 and MViewW at $2d18, so W-then-H transposes them.
    They cannot move to P5MESH either -- DEMOMATH.OBJ's EXTRN resolves by
    Pascal scope in the unit that links it, and declaring them there gives
    `Undefined external (MViewW)`. }
  MViewH : Word = 200;
  MViewW : Word = 320;

{$L DEMOMATH.OBJ}
{ 19 bytes and then a NOP, which pads FixDiv up to 1102:03a5. The pad is
  the assembler aligning the next PROC, not part of the routine.
  @asm 005 1102:0391 +19 FixMul }
procedure FixMul(A, B : LongInt);                         external;
{ @asm 005 1102:03a5 +32 FixDiv }
procedure FixDiv(A, B : LongInt);                         external;
{ @asm 005 1102:11d9 +178 SinCos5 }
procedure SinCos(A : Integer; var C, S : LongInt);        external;
{ @asm 005 1102:128b +334 RotatePoint5 }
procedure RotatePoint(var X, Y, Z : LongInt);             external;
{ @asm 005 1102:13d9 +166 Project5 }
procedure Project(var X, Y, Z : LongInt);                 external;

{ --------------------------------------------------------------------------
one frame of the patch.

  (CX, CY) is where the patch sits in the picture; Angle is in tenths of a
  degree. Every one of the 900 points is read out of the picture, turned, and
  plotted -- there is no mesh and no interpolation, so what you see is 900
  loose pixels.

  Two details that are easy to get wrong by inference. The patch coordinate is
  used TWICE and differently: `Col - 15` picks the pixel out of the picture
  when added to CX, and the SAME `Col - 15` is the 3-D X. And the height is
  not applied in three dimensions at all -- Y is the constant -50 going in,
  and the pixel value is added to the PROJECTED Y at 1102:0132, after the
  divide.
  -------------------------------------------------------------------------- }
{ EIGHT BYTES OF PARAMETERS -- 1102:017b is `RET 8`, and this build was
  emitting `RET $0A`. Four words, not three-plus-a-LongInt: dropping Seg_
  instead was tried and measured 13 bytes WORSE, because the pixel read
  through the parameter had been matching all along. So it is ANGLE that is
  two bytes here, and SinCos takes an Integer anyway. }
{ THE PARAMETERS ARE PX AND PY, NOT CX AND CY, and the reason is the asm block
  below: inside BASM `CX` is a REGISTER, so `MOV AX, CX` would assemble as the
  register move and not the parameter load, silently. The caller's own variables
  keep their names -- only these two are renamed, and only because they are read
  from assembler. }
procedure RenderPatch(PX, PY : Integer; Angle : Integer; Seg_ : Word);
var
  { IN THE ORDER THE RECORDED OFFSETS GIVE. Locals go downward from BP in
    declaration order, so sorting the offsets ascending recovers the original's
    var block. Size and Half were declared first and took the slots nearest BP,
    which pushed X, Y and Z down four bytes each -- and the three pointers
    pushed for Project are where this part's largest span begins. }
  { THE NINE UNACCOUNTED BYTES ARE WHERE SX AND SY LIVE, and the two slots at
    the bottom are not declarations at all. 1102:0004 puts Size at [BP-$1B] and
    Pixel is at [BP-$11], so nine bytes sit between them; and [BP-$23] and
 are the two `for` limits' TEMPORARIES -- 1102:0043 copies Size
    into [BP-$23] and 1102:004c compares against that slot every iteration,
    which is store-then-compare, what a `for` over a non-constant limit does.
    Declaring LimY and LimX produced both the variables AND the temporaries.

    So SX and SY go into the nine, leaving FOUR bytes that nothing references,
    and the arithmetic closes on the odd offset Size sits at: Pixel is one byte
    at [BP-$11], SX and SY take [BP-$13] and [BP-$15], four spare bytes take
 and Size then lands at [BP-$1B] -- an odd offset, which
    is the check, because only a one-byte local above it can produce one. Five
    spare bytes put it at [BP-$1C] and every reference below it a byte out.
    2+2+4+4+4+1 + 2+2+4 + 2+2+2+2 is 33, plus the two temporaries is 37, and
    Turbo Pascal rounds that up to 38 = $26. }
  Col, Row       : Integer;
  X, Y, Z        : LongInt;
  Pixel          : Byte;
  { EIGHT SPARE BYTES, NOT FOUR PLUS SX AND SY. The nine unaccounted bytes were
    read as "SX and SY live here plus four spare", which is arithmetically the
    same and wrong about what they are: the clip-and-sample below is HAND
    ASSEMBLER and holds both coordinates in registers, so there are no such
    variables. [BP-$12]..[BP-$19] is one dead block and the frame total, the
    odd offset Size sits at, and every reference below it are all unchanged. }
  Spare          : array[1..8] of Byte;   { never read }
  Size, Half     : Integer;
  ScreenX        : Integer;
  ScreenY        : Integer;
  { and [BP-$23], [BP-$25] are the compiler's, not ours }
begin
  Size := Patch;
  Half := Size div 2;

  SinCos(Angle, MCos2, MSin2);                   { the only turn }
  SinCos(0, MCos1, MSin1);
  SinCos(0, MCos3, MSin3);

  for Row := 1 to Size do
  begin
    for Col := 1 to Size do
    begin
      Pixel := 0;
      { ----------------------------------------------------------------------
clip the source point and sample it. HAND ASSEMBLER,
        transcribed verbatim, and THREE tells say so independently:

          * BOTH COORDINATES LIVE IN REGISTERS ACROSS FOUR TESTS WITH NO STORE.
            AX holds the column sum from 007f to 00a6 and BX the row sum from
            0092 to 00a2, each compared twice and then USED. Turbo Pascal frames
            every local, so a Pascal `SX` is written before it is tested and read
            back for each comparison -- which is what ours did, seven bytes and
            two dead frame slots' worth.
          * 1102:00a0 is ADD BX,BX where the compiler emits SHL BX,1. That is
            this target's recorded assembler idiom for a doubling.
          * 1102:0087 is 3D 00 00 -- CMP AX,0 in the LONG immediate form -- and
 is 83 FB 00, the SHORT form of the same operation, twenty
            bytes apart. A code generator picks one rule and keeps it; the
            INCONSISTENCY is the signature, the same way part 003's morph scene
            uses JE/JMP five times and then plain JNE three times.

        And ours was wrong in a way that mattered beyond the byte count: with
        YOfs a Word array and SX an Integer, `YOfs[SY] + SX` promotes to LONGINT,
        so ours computed the screen offset in 32 bits (CWD, a CX:BX pair) where
        the original's ADD DI,AX is 16.

        EQUIVALENT PASCAL, for reference -- the assembler below is what runs:

            SX := PX + Col - Half;
            if (SX <= 319) and (SX >= 0) then
            begin
              SY := PY + Row - Half;
              if (SY <= 199) and (SY >= 0) then
                Pixel := Mem[Seg_ : YOfs[SY] + SX];
            end;
        ---------------------------------------------------------------------- }
      asm
              MOV     AX, PX
              ADD     AX, Col
              SUB     AX, Half                { 007f  AX := the column, kept  }
              CMP     AX, 319
              JG      @@Skip
              CMP     AX, 0                   { 0087  the LONG form           }
              JL      @@Skip
              MOV     BX, PY
              ADD     BX, Row
              SUB     BX, Half                { 0092  BX := the row, kept     }
              CMP     BX, 199
              JG      @@Skip
              CMP     BX, 0                   { 009b  and the SHORT form      }
              JL      @@Skip
              ADD     BX, BX                  { 00a0  a word index            }
              MOV     DI, [BX + OFFSET YOfs]  { 00a2  DI := Row * 320         }
              ADD     DI, AX                  { 00a6    + the column, 16-bit  }
              MOV     AX, Seg_
              MOV     ES, AX
              MOV     AL, ES:[DI]             { 00ad  the source pixel        }
              MOV     Pixel, AL
      @@Skip:                                 { 00b3 is the next statement    }
      end;

      X := IntToFixed(Col - Half);
      Z := IntToFixed(Row - Half);
      Y := IntToFixed(LiftY);
      RotatePoint(X, Y, Z);
      Z := Z + IntToFixed(DepthZ);
      Project(X, Y, Z);

      ScreenX := 320 - Integer(TLongRec(X).Lo);
      ScreenY := Integer(TLongRec(Y).Lo) - YBias + Pixel;

      if (ScreenX > 0) and (ScreenX < 319) and
         (ScreenY > 0) and (ScreenY < 199) then
        PutPixel(ScreenX, ScreenY, Pixel, VirtScrSeg);
    end;
  end;
end;

{ --------------------------------------------------------------------------
the frame loop.

  The patch wanders diagonally at two pixels a frame and reflects off all four
  edges of the picture. At frame 100 it stops moving and the rotation jumps to
  three degrees a frame; at 220 it starts moving again and the rotation drops
  back to one degree. From frame 500 the palette dims a step each frame, and
  at 564 it stops. A keypress jumps the frame count straight to 500, so the
  fade-out is what a key buys you.
  -------------------------------------------------------------------------- }
procedure Run;
var
  { IN THE ORDER THE RECORDED OFFSETS GIVE -- $2, $4, $6, $8, $A, $C, $E, then
    the Boolean at $F, which is why Running goes LAST and not first. Seven
    words and a byte is fifteen, and the frame is ENTER $10.

    ANGLE IS TWO BYTES. It cannot be a LongInt: DY_ is at [BP-8] and Angle at
 so there is no room, and 1102:0190 zeroes it with a single word
    store. That agrees with RenderPatch, whose RET 8 leaves two bytes for it. }
  CX, CY   : Integer;
  DX_, DY_ : Integer;
  { A WORD, NOT AN INTEGER, and the widening says so. 1102:022d is XOR DX,DX on
 where 1102:0225 is CWD on [BP-$0C] -- unsigned against signed, in
    the same expression, two instructions apart. So Angle is a Word and AngStep
    an Integer, and the `mod` that follows is a 32-bit divide of the mixed sum.

    THE OPERAND ORDER FOLLOWS FROM IT TOO. The Integer is the one PARKED in
    CX:BX and the Word is the one left in AX:DX, so the parked one is written
    SECOND: the source is `Angle + AngStep` and not the other way round. }
  Angle    : Word;
  AngStep  : Integer;
  { A WORD, NOT AN INTEGER, AND THE BRANCH SAYS SO. 1102:01f5 and 1102:0210 are
    JB where a signed compare gives JL -- the same two bytes with the wrong
    condition -- so `Frame >= 500` and `Frame >= 564` are UNSIGNED comparisons
    and Frame is unsigned. Nothing else about the routine changes: Frame runs
    0..564 and never goes negative, so the two forms behave identically here and
    only the 1994 bytes say which was written. }
  Frame    : Word;
  Running  : Boolean;
begin
  Running := True;
  CX      := 160;
  CY      := 100;
  Angle   := 0;
  AngStep := 0;
  Frame   := 0;
  DX_     := 2;
  DY_     := 2;
  repeat
    { the test is in the binary and is redundant: the loop only
      goes round again while Running is set. Transcribed as it stands. }
    if Running then Inc(Frame);

    if KeyPressed then
    begin
      Frame := 500;
      ReadKey;
    end;
    if Frame = 100 then
    begin
      DX_ := 0;  DY_ := 0;  AngStep := 30;
    end;
    if Frame = 220 then
    begin
      DX_ := 2;  DY_ := 2;  AngStep := 10;
    end;
    if Frame >= 500 then
    begin
      PaletteDim(@Pal);
      SetPalette768(@Pal);
    end;
    if Frame >= 564 then Running := False;

    { Inc, NOT AN ASSIGNMENT, AND IT IS THE OPPOSITE WAY ROUND FROM P1LOGO. The
      original is MOV AX,[BP-6] / ADD [BP-2],AX -- six bytes, the addend loaded
      and added straight into memory -- where `CX := CX + DX_` loads CX first,
      adds, and stores back: nine. Three bytes each, six across the pair, and
      that was the whole of this unit's excess.

      P1LOGO's two bouncer updates went the other way: there the ORIGINAL wrote
      the assignment and recomputed the subscript three times, and Inc was the
      shorter form we had to give up. The ADD's operand direction names which
      was written -- ADD [mem],reg is Inc, ADD reg,[mem] with a store after is
      the assignment -- and it has now been read in both directions in one
      corpus. }
    Inc(CX, DX_);
    Inc(CY, DY_);
    Angle := (Angle + AngStep) mod FullTurn;

    if CX < 0   then begin CX := 0;   DX_ := -DX_ end;
    if CX > 319 then begin CX := 319; DX_ := -DX_ end;
    if CY < 0   then begin CY := 0;   DY_ := -DY_ end;
    if CY > 199 then begin CY := 199; DY_ := -DY_ end;

    ClearScreen(VirtScrSeg, 0);
    RenderPatch(CX, CY, Angle, PicSeg);
    CopyScreen(VirtScrSeg, $A000);
  until not Running;
end;

{ --------------------------------------------------------------------------
the picture and its palette.

  ASSETS  NEUROSIS.DAT $001646E5:
            64,000 bytes  a 320 x 200 picture
            768 bytes     its palette
  -------------------------------------------------------------------------- }
procedure Setup;
var
  { ENTER $82 IS 130 BYTES AND NOT ONE OF THEM IS REFERENCED -- the routine
    touches no [BP-n] slot at any width in its whole body. So this is 130 bytes
    of declaration that nothing reads, and ours had no frame at all.

    128 + 2 is a file record and one more word, and a file record is what this
    part's other scenes declare and leave unopened in the same position: P6WHOOSH's
    Load, P6TILES's Setup and P6CREDIT's Setup all do it. The file this routine
    actually uses is the GLOBAL at DS:$A984, which 1102:02ed pushes.

    The TYPES are a guess and only the total is measured. }
  Unread : file;                  { never referenced }
  Spare  : Integer;               { never referenced }
begin
  GetMem(Pic, 64000);
  PicSeg := Seg(Pic^);
  Assign(F, 'neurosis.dat');
  Reset(F, 1);
  Seek(F, DataOfs);
  BlockRead(F, Pic^, 64000);
  BlockRead(F, Pal, SizeOf(Pal));
  Close(F);
  SetPalette768(@Pal);
end;

{ the scene. }
procedure Scene3;
begin
  MScale := RealToFixed(ScaleR);                 { 1600.0 }
  Setup;
  Run;
  FreeMem(Pic, 64000);
end;

{ the unit's initialisation is empty. }
begin
end.
