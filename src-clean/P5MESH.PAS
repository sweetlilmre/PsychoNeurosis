{ ===========================================================================
  Psycho Neurosis (Asphyxia, 1994) -- NEUROSIS.005 scene 1, segment 100e.

  A 32 x 32 grid of points is projected and drawn as 1,922 filled triangles.
  The height of each point comes from a 1,024-byte greyscale map read off
  NEUROSIS.DAT and THRESHOLDED -- and it is the threshold that is animated, so
  the landscape grows out of a flat plane and sinks back into it. Three maps
  are read in turn and each is morphed up and down.

  Read from the binary instruction by instruction; nothing here is inferred.
  See docs/26-part5-notes.md for the reading.

  ADDRESS MAP
    FillTriangle    100e:0000     Project         100e:05d3
    BuildRowTable   100e:04e6     Morph           100e:06ae
    BuildGrid       100e:050b     BuildRamp       100e:073c
    HeightFromMap   100e:056d     FadeUpDot       100e:076c
    DrawMesh        100e:062a     Scene1          100e:07a4

  DGROUP
 the triangle list, 1922 x 3 words   -- initialised data
 the clip window: 0, 199, 0, 319     -- initialised data
 the height map, 1024 bytes
 the grid, 1024 x (X, Y, Z) as words
 the projected vertices, 1024 x (SX, SY : Word; Col : Byte)
 the file variable
 a row table, 200 words -- scene 1 keeps its own
 the edge buffer FillTriangle fills top-down and reads bottom-up
  =========================================================================== }

{$G+}   { 186: FillTriangle's scan converters are bracketed by PUSHA/POPA in
          DrawMesh, and the shifts take immediates. }
{$S-}   { STACK CHECKING OFF, and part 005 does NOT settle this in one answer:
          FixMath's copy in this part (segment 124a) opens
          MOV AX,4 / CALLF 12d9:0530 / SUB SP,4, so THAT unit was built with
          it on -- but segment 100e opens ENTER $1A,0 with no check at all. So
          the setting is per unit, and this one is off. With it on Turbo
          Pascal emits PUSH BP / MOV BP,SP / MOV AX,n / CALLF and never ENTER,
          which pushes every routine here seven bytes out of step. }

unit P5MESH;
{$I-}   { no I/O check: the original goes straight on after each file
          call, with no near CALL to the RTL's check routine. }

interface

procedure Scene1;

implementation

uses Crt, VGA;

{$I gen/DATOFS.INC}   { NEUROSIS.DAT offsets and lengths, generated by
                        tools/mkdat.py from assets/NEUROSIS.MAN. Every
                        constant in it is UNTYPED, so including the whole
                        set costs no storage and changes no data image. }

const
  GridSide  = 32;                  { the grid is 32 x 32 }
  GridVerts = GridSide * GridSide; { counts to $3FF }
  NumTris   = 1922;                { loads $782 }
  Spacing   = 20;                  { IMUL AX,AX,$14 }
  RestZ     = 300;                 { the flat plane }
  BaseZ     = 250;                 { what a thresholded point sits at }

  DataOfs   = DAT_P5_HEIGHT1;   { $153DE5 -- 100e:07c7 pushes $0015 then $3DE5 }
  MapSize   = $400;                { 1024 bytes per height map }

type
  TPoint3  = record X, Y, Z : Integer end;
  TProj    = record SX, SY : Integer; Col : Byte end;   { 5 bytes }
  TTri     = array[1..3] of Word;

{$I gen/P5MESH.INC}   { const MeshTris : array[1..NumTris] of TTri }

var
  { THE ORDER IS THE ADDRESSES', and it was not: HeightMap came third and the
    file record last. Sorted, the recorded addresses tile with one gap left:

        $2D7E  HeightMap   1024
        $317E  Grid        6144   (1024 x 6)
        $497E  Proj        5120   (1024 x 5)
        $5D7E  F            128
        $5DFE  RowOfs       400   -- and 112 bytes to the next, unaccounted
        $5FDE  EdgeBuf     1002   to the next unit's block at $63C8

    EdgeBuf is declared array[0..799] here, which is 1600 bytes, and only 1002
    are available before scene 2's data begins -- so it is 598 too big. That is
    left alone for now: the size is not measured, only bounded, and this unit's
    surplus over the original is 384 bytes rather than 598, so there is a
    missing declaration in here as well as an oversized one. }
  HeightMap : array[0..MapSize - 1] of Byte;
  Grid   : array[0..GridVerts - 1] of TPoint3;
  Proj   : array[0..GridVerts - 1] of TProj;
  { the file record, BEFORE the two tables and not after }
  F      : file;
  { scene 1's own row table, not the VGA unit's }
  RowOfs : array[0..199] of Word;
  { EIGHTY BYTES DECLARED AND NEVER REFERENCED, and the note this
    replaces said 112 on an arithmetic slip that cost thirty-two bytes for days.
    RowOfs starts at $5DFE and its 200 words end at $5DFE + 400 = **$5F8E**, not
    the $5F6E that was written here; EdgeBuf's own address is $5FDE, so the gap
    is EIGHTY bytes and not 112.

    THE SLIP WAS INVISIBLE BECAUSE IT BALANCED SOMEWHERE ELSE. Thirty-two bytes
    too many here pushed the whole of scene 2's block up by thirty-two -- I1 at
    $63E8 against $63C8, and every one of its four tables with it -- and scene
    2's own Spare was then tuned thirty short of its true size to bring scene 3
    back into place. Both totals stayed exactly right: dgimage reported 11,648
    bytes against 11,648 with no differing byte and minalloc matched to the
    paragraph, because nothing was missing or surplus -- thirty-two bytes were
    in the wrong PLACE. A total that balances is not a layout that matches.

    Nothing in any of part 005's seven segments touches an address between
    RowOfs's end and EdgeBuf, so this is still a declaration the original makes
    and never uses; only its size was wrong. The TYPE remains unmeasurable and a
    byte array is the least assuming thing that occupies exactly eighty. }
  Spare  : array[1..80] of Byte;
  { two words per scanline, written going down and read going up.
    501 WORDS, not 800: $5FDE plus 1002 is $63C8, which is exactly where scene
    2's data begins, so 1002 bytes is all the room there is. Declared
    array[0..799] this was 1600 bytes and overran the next unit's block by 598,
    which in our build simply made DGROUP bigger and in the original would be
    impossible. }
  EdgeBuf : array[0..500] of Word;

const
  { DS:$2d0e..$2d14 -- INITIALISED DATA, read straight out of the image:
    00 00  C7 00  00 00  3F 01. The full 320 x 200 screen. FillTriangle reads
    all four, so they are typed constants rather than plain consts: a plain
    const would fold into the instruction and stop matching. }
  ClipTop    : Integer = 0;
  ClipBottom : Integer = 199;
  ClipLeft   : Integer = 0;
  ClipRight  : Integer = 319;

{ --------------------------------------------------------------------------
the filled-triangle scan converter. HAND ASSEMBLER, verbatim.

  EQUIVALENT PASCAL, for reference -- the assembler below is what runs:

      sort the three vertices so Y1 <= Y2 <= Y3
      reject anything with no area, or wholly above or below the clip window
      for each edge, Bresenham: Step := Dx div Dy, Err := Dx mod Dy, both
        floored towards minus infinity rather than towards zero
      walk both active edges down the triangle, pushing the two X values of
        every scanline into EdgeBuf
      then walk EdgeBuf BACK UP, clipping each pair to ClipLeft..ClipRight and
        filling the span with REP STOSW

  It cannot be written that way and still be the same code. The routine has
  FOUR scan converters -- flat-top, flat-bottom, and the two general cases
  told apart by the sign of the cross product -- which differ only in which
  edge feeds DI and which feeds SI. Turbo Pascal would emit one parameterised
  loop; the original unrolled it, and the unrolling is the routine.

  THE FLOORED DIVIDE. Turbo Pascal's div truncates towards zero. Every one of
  the six divisions here is followed by

      CMP CX, 0        the numerator
      JGE +5
      DEC AX           quotient
      ADD DX, BX       remainder += divisor

  which converts it to a floor. Without that the error term goes negative and
  the edge walks the wrong way.
  -------------------------------------------------------------------------- }
{ @asm 005 100e:0000 +1254 FillTriangle }
procedure FillTriangle(X1, Y1, X2, Y2, X3, Y3 : Integer;
                       Colour : Byte; Segment : Word); assembler;
var
  { ENTER $1A -- thirteen words, and the ORDER IS LOAD-BEARING: the original
    reads them at [BP-2] through [BP-$1A] in exactly this sequence. }
  Dx12, Dx13, Dx23    : Integer;
  Dy12, Dy13, Dy23    : Integer;
  Err12, Err13, Err23 : Integer;
  Stp12, Stp13, Stp23 : Integer;
  RightX              : Integer;
asm
  PUSH ES
  PUSH DI
  MOV  AX, X1                { AX,BX = vertex 1                   }
  MOV  BX, Y1
  MOV  CX, X2                { CX,DX = vertex 2                   }
  MOV  DX, Y2                { vertex 3 stays in the frame      }
  CMP  AX, CX                { all three X equal?                 }
  JNZ  @Sort
  CMP  CX, X3
  JNZ  @Sort
  JMP  @Done                 { a vertical line has no area        }

{ ---- sort the three vertices by Y ---- }
@Sort:
  CMP  BX, DX
  JG   @Swap1
  JMP  @Sorted2
@Swap1:
  XCHG AX, CX                { vertex 1 <-> vertex 2              }
  XCHG BX, DX
@Sorted2:
  CMP  DX, Y3
  JG   @Swap2
  JMP  @Sorted3
@Swap2:
  XCHG X3, CX                { vertex 2 <-> vertex 3, in the frame}
  XCHG Y3, DX
  CMP  BX, DX                { which may have unsorted 1 and 2    }
  JG   @Swap3
  JMP  @Sorted3
@Swap3:
  XCHG AX, CX
  XCHG BX, DX
@Sorted3:
  CMP  BX, DX                { Y1 = Y2 -- a flat top?             }
  JZ   @FlatTopTest
  JMP  @Test23

@FlatTopTest:
  CMP  DX, Y3                { and Y2 = Y3 as well?               }
  JNZ  @FlatTopOrder
  JMP  @Done                 { all three on one row: no area      }
@FlatTopOrder:
  CMP  AX, CX                { the flat edge must run left->right }
  JG   @FlatTopSwap
  JGE  @DoneJmp              { equal: no area                     }
  JMP  @FlatTop
@DoneJmp:
  JMP  @Done
@FlatTopSwap:
  XCHG AX, CX
  JMP  @FlatTop

@Test23:
  CMP  DX, Y3                { Y2 = Y3 -- a flat bottom?          }
  JZ   @FlatBotOrder
  JMP  @General
@FlatBotOrder:
  CMP  CX, X3
  JG   @FlatBotSwap
  JGE  @DoneJmp2             { wrong: JGE means equal -- no area  }
  JMP  @FlatBot
@DoneJmp2:
  JMP  @Done
@FlatBotSwap:
  XCHG X3, CX
  JMP  @FlatBot

{ ======== the general case: three distinct Y values ======== }
@General:
  MOV  X1, AX                { put the sorted vertices back       }
  MOV  Y1, BX
  MOV  X2, CX
  MOV  Y2, DX
  MOV  DI, Y3
  CMP  DI, ClipTop           { the whole triangle above the top?  }
  JGE  @GenB
  JMP  @Done
@GenB:
  MOV  DI, Y1
  CMP  DI, ClipBottom        { ...or below the bottom?            }
  JLE  @GenEdges
  JMP  @Done

@GenEdges:
  MOV  BX, DX                { edge 1->2                          }
  SUB  BX, Y1
  MOV  Dy12, BX
  MOV  AX, X2
  SUB  AX, X1
  MOV  Dx12, AX
  MOV  CX, AX                { keep the numerator's sign          }
  CWD
  IDIV BX
  CMP  CX, 0
  JGE  @Keep12
  DEC  AX                    { floor, not truncate                }
  ADD  DX, BX                { and keep the remainder positive  }
@Keep12:
  MOV  Stp12, AX
  MOV  Err12, DX

  MOV  BX, Y3                { edge 1->3, the long one            }
  SUB  BX, Y1
  MOV  Dy13, BX
  MOV  AX, X3
  SUB  AX, X1
  MOV  Dx13, AX
  MOV  CX, AX
  CWD
  IDIV BX
  CMP  CX, 0
  JGE  @Keep13
  DEC  AX
  ADD  DX, BX
@Keep13:
  MOV  Stp13, AX
  MOV  Err13, DX

  MOV  BX, Y3                { edge 2->3                          }
  SUB  BX, Y2
  JLE  @Cross                { none of it: skip, it is unused     }
  MOV  Dy23, BX
  MOV  AX, X3
  SUB  AX, X2
  MOV  Dx23, AX
  MOV  CX, AX
  CWD
  IDIV BX
  CMP  CX, 0
  JGE  @Keep23
  DEC  AX
  ADD  DX, BX
@Keep23:
  MOV  Stp23, AX
  MOV  Err23, DX

{ Which side is the middle vertex on? Dx12*Dy13 against Dx13*Dy12 -- the
  cross product, as two 32-bit products compared high word first. }
@Cross:
  MOV  AX, Dx12
  IMUL Dy13                  { DX:AX := Dx12 * Dy13               }
  MOV  BX, AX
  MOV  CX, DX
  MOV  AX, Dx13
  IMUL Dy12                  { DX:AX := Dx13 * Dy12               }
  CMP  CX, DX
  JG   @Left
  JGE  @CrossLow             { high words equal: compare low      }
  JMP  @Right
@CrossLow:
  CMP  BX, AX
  JA   @Left                 { unsigned: the low halves           }
  JNC  @CrossZero
  JMP  @Right
@CrossZero:
  JMP  @Done                 { collinear: no area                 }

{ ---- general case A: DI walks 1->3, SI walks 1->2 then 2->3 ---- }
@Left:
  MOV  AX, 0                 { the two error accumulators         }
  MOV  BX, 0
  MOV  CX, Y1                { CX is the scanline                 }
  MOV  DI, X1
  MOV  SI, DI                { both edges start at vertex 1       }
  XOR  DX, DX                { DX indexes EdgeBuf                 }
  CMP  CX, ClipTop
  JGE  @LeftTop
  MOV  DX, ClipTop
  MOV  Y1, DX
  MOV  DX, Y1
  CMP  DX, Y3
  JNZ  @LeftReset
  JMP  @Done
@LeftReset:
  XOR  DX, DX
@LeftTop:
  CMP  CX, ClipTop           { above the window: step, do not     }
  JL   @LeftStep1            { record                           }
  MOV  ES, BX                { BX is in use, so ES is the spare   }
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], DI
  MOV  BX, ES
  ADD  DX, 2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], SI
  MOV  BX, ES
  ADD  DX, 2
@LeftStep1:
  ADD  AX, Err13
  JLE  @LeftNoCarry1
  SUB  AX, Dy13
  INC  DI
@LeftNoCarry1:
  ADD  DI, Stp13             { the step happens either way        }
  ADD  BX, Err12
  JLE  @LeftNoCarry2
  SUB  BX, Dy12
  INC  SI
@LeftNoCarry2:
  ADD  SI, Stp12
  INC  CX
  CMP  CX, ClipBottom
  JL   @LeftMid
  MOV  Y3, CX                { ran off the bottom: stop here      }
  JMP  @Span
@LeftMid:
  CMP  CX, Y2                { still in the upper half?           }
  JL   @LeftTop

@LeftLower:
  CMP  CX, ClipTop
  JL   @LeftStep2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], DI
  MOV  BX, ES
  ADD  DX, 2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], SI
  MOV  BX, ES
  ADD  DX, 2
@LeftStep2:
  ADD  AX, Err13             { DI is still on the long edge       }
  JLE  @LeftNoCarry3
  SUB  AX, Dy13
  INC  DI
@LeftNoCarry3:
  ADD  DI, Stp13
  ADD  BX, Err23             { SI has moved on to edge 2->3       }
  JLE  @LeftNoCarry4
  SUB  BX, Dy23
  INC  SI
@LeftNoCarry4:
  ADD  SI, Stp23
  INC  CX
  CMP  CX, ClipBottom
  JL   @LeftEnd
  MOV  Y3, CX
@LeftEnd:
  CMP  CX, Y3
  JL   @LeftLower
  JMP  @Span

{ ---- general case B: DI walks 1->2 then 2->3, SI walks 1->3 ---- }
@Right:
  MOV  AX, 0
  MOV  BX, 0
  MOV  CX, Y1
  MOV  DI, X1
  MOV  SI, X1
  XOR  DX, DX
  CMP  CX, ClipTop
  JGE  @RightTop
  MOV  DX, ClipTop
  MOV  Y1, DX
  MOV  DX, Y1
  CMP  DX, Y3
  JNZ  @RightReset
  JMP  @Done
@RightReset:
  XOR  DX, DX
@RightTop:
  CMP  CX, ClipTop
  JL   @RightStep1
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], DI
  MOV  BX, ES
  ADD  DX, 2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], SI
  MOV  BX, ES
  ADD  DX, 2
@RightStep1:
  ADD  AX, Err12             { DI is on the short edge here       }
  JLE  @RightNoCarry1
  SUB  AX, Dy12
  INC  DI
@RightNoCarry1:
  ADD  DI, Stp12
  ADD  BX, Err13
  JLE  @RightNoCarry2
  SUB  BX, Dy13
  INC  SI
@RightNoCarry2:
  ADD  SI, Stp13
  INC  CX
  CMP  CX, ClipBottom
  JL   @RightMid
  MOV  Y3, CX
  JMP  @Span
@RightMid:
  CMP  CX, Y2
  JL   @RightTop

@RightLower:
  CMP  CX, ClipTop
  JL   @RightStep2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], DI
  MOV  BX, ES
  ADD  DX, 2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], SI
  MOV  BX, ES
  ADD  DX, 2
@RightStep2:
  ADD  AX, Err23             { DI has moved on to edge 2->3       }
  JLE  @RightNoCarry3
  SUB  AX, Dy23
  INC  DI
@RightNoCarry3:
  ADD  DI, Stp23
  ADD  BX, Err13             { SI is still on the long edge       }
  JLE  @RightNoCarry4
  SUB  BX, Dy13
  INC  SI
@RightNoCarry4:
  ADD  SI, Stp13
  INC  CX
  CMP  CX, ClipBottom
  JL   @RightEnd
  MOV  Y3, CX
  JMP  @Span
@RightEnd:
  CMP  CX, Y3
  JL   @RightLower
  JMP  @Span

{ ======== flat top: Y1 = Y2, one pair of edges down to vertex 3 ======== }
@FlatTop:
  MOV  X1, AX
  MOV  Y1, BX
  MOV  X2, CX
  MOV  Y2, DX
  MOV  DI, Y3
  CMP  DI, ClipTop
  JGE  @FlatTopB
  JMP  @Done
@FlatTopB:
  MOV  DI, Y1
  CMP  DI, ClipBottom
  JLE  @FlatTopEdges
  JMP  @Done
@FlatTopEdges:
  MOV  BX, Y3                { edge 1->3, into the 1->2 slots     }
  SUB  BX, Y1
  MOV  Dy12, BX
  MOV  AX, X3
  SUB  AX, X1
  MOV  Dx12, AX
  MOV  CX, AX
  CWD
  IDIV BX
  CMP  CX, 0
  JGE  @FTKeep1
  DEC  AX
  ADD  DX, BX
@FTKeep1:
  MOV  Stp12, AX
  MOV  Err12, DX
  MOV  BX, Y3                { edge 2->3, into the 1->3 slots     }
  SUB  BX, Y2
  MOV  Dy13, BX
  MOV  AX, X3
  SUB  AX, X2
  MOV  Dx13, AX
  MOV  CX, AX
  CWD
  IDIV BX
  CMP  CX, 0
  JGE  @FTKeep2
  DEC  AX
  ADD  DX, BX
@FTKeep2:
  MOV  Stp13, AX
  MOV  Err13, DX
  MOV  AX, 0
  MOV  BX, 0
  MOV  CX, Y1
  MOV  DI, X1                { the two ends of the flat top       }
  MOV  SI, X2
  XOR  DX, DX
  CMP  CX, ClipTop
  JGE  @FTLoop
  MOV  DX, ClipTop
  MOV  Y1, DX
  MOV  DX, Y1
  CMP  DX, Y3
  JNZ  @FTReset
  JMP  @Done
@FTReset:
  XOR  DX, DX
@FTLoop:
  CMP  CX, ClipTop
  JL   @FTStep
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], DI
  MOV  BX, ES
  ADD  DX, 2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], SI
  MOV  BX, ES
  ADD  DX, 2
@FTStep:
  ADD  AX, Err12
  JLE  @FTNoCarry1
  SUB  AX, Dy12
  INC  DI
@FTNoCarry1:
  ADD  DI, Stp12
  ADD  BX, Err13
  JLE  @FTNoCarry2
  SUB  BX, Dy13
  INC  SI
@FTNoCarry2:
  ADD  SI, Stp13
  INC  CX
  CMP  CX, ClipBottom
  JL   @FTEnd
  MOV  Y3, CX
  JMP  @Span
@FTEnd:
  CMP  CX, Y3
  JL   @FTLoop
  JMP  @Span

{ ======== flat bottom: Y2 = Y3, one apex at vertex 1 ======== }
@FlatBot:
  MOV  X1, AX
  MOV  Y1, BX
  MOV  X2, CX
  MOV  Y2, DX
  MOV  DI, Y3
  CMP  DI, ClipTop
  JGE  @FlatBotB
  JMP  @Done
@FlatBotB:
  MOV  DI, Y1
  CMP  DI, ClipBottom
  JLE  @FlatBotEdges
  JMP  @Done
@FlatBotEdges:
  MOV  BX, Y2                { edge 1->2                          }
  SUB  BX, Y1
  MOV  Dy12, BX
  MOV  AX, X2
  SUB  AX, X1
  MOV  Dx12, AX
  MOV  CX, AX
  CWD
  IDIV BX
  CMP  CX, 0
  JGE  @FBKeep1
  DEC  AX
  ADD  DX, BX
@FBKeep1:
  MOV  Stp12, AX
  MOV  Err12, DX
  MOV  BX, Y3                { edge 1->3                          }
  SUB  BX, Y1
  MOV  Dy13, BX
  MOV  AX, X3
  SUB  AX, X1
  MOV  Dx13, AX
  MOV  CX, AX
  CWD
  IDIV BX
  CMP  CX, 0
  JGE  @FBKeep2
  DEC  AX
  ADD  DX, BX
@FBKeep2:
  MOV  Stp13, AX
  MOV  Err13, DX
  MOV  AX, 0
  MOV  BX, 0
  MOV  CX, Y1
  MOV  DI, X1                { both edges leave the same apex     }
  MOV  SI, X1
  XOR  DX, DX
  CMP  CX, ClipTop
  JGE  @FBLoop
  MOV  DX, ClipTop
  MOV  Y1, DX
  MOV  DX, Y1
  CMP  DX, Y3
  JNZ  @FBReset
  JMP  @Done
@FBReset:
  XOR  DX, DX
@FBLoop:
  CMP  CX, ClipTop
  JL   @FBStep
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], DI
  MOV  BX, ES
  ADD  DX, 2
  MOV  ES, BX
  MOV  BX, DX
  MOV  [BX + OFFSET EdgeBuf], SI
  MOV  BX, ES
  ADD  DX, 2
@FBStep:
  ADD  AX, Err12
  JLE  @FBNoCarry1
  SUB  AX, Dy12
  INC  DI
@FBNoCarry1:
  ADD  DI, Stp12
  ADD  BX, Err13
  JLE  @FBNoCarry2
  SUB  BX, Dy13
  INC  SI
@FBNoCarry2:
  ADD  SI, Stp13
  INC  CX
  CMP  CX, ClipBottom
  JL   @FBEnd
  MOV  Y3, CX
  JMP  @Span
@FBEnd:
  CMP  CX, Y3
  JL   @FBLoop

{ ======== the spans, read back out of EdgeBuf from the bottom up ======== }
@Span:
  CLD
  MOV  CX, Y3                { the last row reached               }
  MOV  AX, Segment
  MOV  ES, AX
  SUB  DX, 2                 { step back onto the last word       }
@SpanRow:
  MOV  BX, DX
  MOV  AX, [BX + OFFSET EdgeBuf]       { the SI edge -- the right-hand X    }
  CMP  AX, ClipRight
  JLE  @SpanR
  MOV  AX, ClipRight
@SpanR:
  MOV  RightX, AX
  SUB  DX, 2
  MOV  BX, DX
  MOV  AX, [BX + OFFSET EdgeBuf]       { the DI edge -- the left-hand X     }
  CMP  AX, ClipLeft
  JGE  @SpanL
  MOV  AX, ClipLeft
@SpanL:
  SUB  DX, 2                 { on to the row above                }
  CMP  CX, ClipTop
  JL   @SpanNext
  CMP  CX, ClipBottom
  JG   @SpanNext
  MOV  BX, CX
  ADD  BX, BX
  MOV  DI, [BX + OFFSET RowOfs]
  ADD  DI, AX                { ES:DI is the left end of the span  }
  MOV  BX, RightX
  SUB  BX, AX                { BX := the width                    }
  JLE  @SpanNext
  MOV  AX, BX                { rotate: CX := width, BX := the row }
  MOV  BX, CX
  MOV  CX, AX
  MOV  AX, WORD PTR Colour
  MOV  AH, AL                { the same byte in both halves       }
  SHR  CX, 1
  REP  STOSW
  JNC  @SpanEven
  STOSB                      { odd width: one byte left over      }
@SpanEven:
  MOV  CX, BX                { CX is the row again                }
@SpanNext:
  DEC  CX
  CMP  CX, Y1
  JG   @SpanRow
@Done:
  POP  DI
  POP  ES
end;

{ --------------------------------------------------------------------------
scene 1's own row table. The VGA unit has one; this scene does
  not use it, and builds its own at DS:$5dfe.
  -------------------------------------------------------------------------- }
procedure BuildRowTable;
var I : Integer;
begin
  for I := 0 to 199 do RowOfs[I] := I * 320;    { IMUL AX,I,$140 }
end;

{ --------------------------------------------------------------------------
the 32 x 32 grid, centred on the origin and pushed back to
  Z = 300 so the projection has something to divide by.
  -------------------------------------------------------------------------- }
procedure BuildGrid;
var I : Integer;
begin
  for I := 0 to GridVerts - 1 do
  begin
    Grid[I].X := ((I mod GridSide) - 16) * Spacing;   { IDIV 32 }
    Grid[I].Y := ((I shr 5) - 16) * Spacing;          { SHR -- so
                                                        unsigned, not IDIV }
    Grid[I].Z := RestZ;
  end;
end;

{ --------------------------------------------------------------------------
turn the height map into Z values at a given threshold.

  Anything at or below the threshold sits on the base plane; anything above it
  is pulled TOWARDS the viewer by however far it clears the threshold. So
  lowering the threshold raises more of the landscape, and that is the whole
  animation.
  -------------------------------------------------------------------------- }
procedure HeightFromMap(Threshold : Byte);
var
  { ENTER $04 is four bytes and only [BP-2] is read, so the two below it are
    declared and never touched. NOT a for-loop temporary: 100e:05c8 compares
 against the constant $3FF directly, and a constant limit needs no
    temporary -- which is the other half of what probe/TWOBYTE.PAS measured. }
  I     : Integer;
  Spare : Integer;                { never referenced }
begin
  { A DEAD SELF-ASSIGNMENT OF THE PARAMETER, and it is the first thing the
    routine does. 100e:0571 is MOV AL,[BP+4] / MOV [BP+4],AL -- a byte loaded
    from the parameter slot and stored straight back to it. Six bytes that
    cannot change anything, and another instance of the shape this target keeps
    finding after part 004's forty-nine conditional self-assignments, part 001's
    two dead tests and part 003's addition of zero. Transcribed because it is
    what ships. }
  Threshold := Threshold;
  for I := 0 to GridVerts - 1 do
    if HeightMap[I] > Threshold then                  { JBE }
      Grid[I].Z := BaseZ - (HeightMap[I] - Threshold)
    else
      Grid[I].Z := BaseZ;
end;

{ --------------------------------------------------------------------------
project the grid. HAND ASSEMBLER, verbatim.

  EQUIVALENT PASCAL, for reference -- the assembler below is what runs:

      for I := 0 to 1023 do
      begin
        Proj[I].SX  := 160 - (Grid[I].X shl 6) div Grid[I].Z;
        Proj[I].SY  := 100 - ((-Grid[I].Y) shl 6) div Grid[I].Z;
        Proj[I].Col := ((250 - Grid[I].Z) mod 255) + 1;
      end;

  The original cannot be written that way: it USES BP AS A SCRATCH REGISTER
  for Z, which is why it pushes BP separately from the frame, and it walks
  both arrays with LODSW/STOSW rather than indexing them.
  -------------------------------------------------------------------------- }
{ @asm 005 100e:05d3 +87 Project }
procedure Project(Src, Dst : Pointer); assembler;
asm
  PUSH DS                { DS is about to be the source array     }
  PUSH BP                { and BP is about to hold Z              }
  MOV  CX, 0FFh * 4 + 3  { written $3FF in the binary     }
  LDS  SI, Src           { DS:SI := the grid                      }
  LES  DI, Dst           { ES:DI := the projected vertices        }
@Point:
  PUSH CX                { CX is needed for the divide            }
  LODSW                  { AX := X                                }
  SHL  AX, 6             { X * 64 -- the focal length             }
  MOV  BX, AX
  LODSW                  { AX := Y                                }
  NEG  AX                { screen Y runs downwards                }
  SHL  AX, 6
  MOV  CX, AX
  LODSW                  { AX := Z                                }
  MOV  BP, AX            { <- BP, not a frame pointer any more    }
  MOV  AX, BX
  MOV  BX, BP
  CWD
  IDIV BX                { (X*64) div Z                           }
  MOV  BX, 0A0h          { 160 -- the centre of the screen        }
  SUB  BX, AX
  MOV  AX, BX
  STOSW                  { -> SX                                  }
  MOV  AX, CX
  MOV  CX, BP
  CWD
  IDIV CX                { (-Y*64) div Z                          }
  MOV  CX, 64h           { 100 -- the middle row                  }
  SUB  CX, AX
  MOV  AX, CX
  STOSW                  { -> SY                                  }
  MOV  AX, 0FAh          { 250                                    }
  SUB  AX, BP            { how far this point stands proud        }
  MOV  BX, 0FFh
  CWD
  IDIV BX
  MOV  AX, DX            { the REMAINDER, not the quotient        }
  INC  AX                { colour 0 is the background             }
  STOSB                  { -> Col, so the record is five bytes    }
  POP  CX
  DEC  CX
  JNS  @Point            { JNS, so 1024 points and not 1023       }
  POP  BP
  POP  DS
end;

{ --------------------------------------------------------------------------
draw the whole mesh. HAND ASSEMBLER, verbatim.

  EQUIVALENT PASCAL, for reference -- the assembler below is what runs:

      ClearScreen(VirtScrSeg, 0);
      for T := 1 to 1922 do
        FillTriangle(Proj[Tri[T,1]].SX, Proj[Tri[T,1]].SY,
                     Proj[Tri[T,2]].SX, Proj[Tri[T,2]].SY,
                     Proj[Tri[T,3]].SX, Proj[Tri[T,3]].SY,
                     Proj[Tri[T,3]].Col, VirtScrSeg);
      CopyScreen(VirtScrSeg, $A000);

  Two things stop that being the same code. The vertex record is five bytes,
  so the original indexes it as I*4 + I rather than by a multiply; and the
  colour byte is fetched by reading the WORD at +3 and keeping its high half,
  which is one instruction shorter than a byte load.
  -------------------------------------------------------------------------- }
{ @asm 005 100e:062a +132 DrawMesh }
procedure DrawMesh(Verts, Tris : Pointer); assembler;
var
  { is ENTER $0002,0 -- one word of locals that NOTHING in the
    routine reads. It is declared so the frame is the size the binary has;
    leaving it out makes Turbo Pascal emit a bare PUSH BP / MOV BP,SP and the
    whole routine shifts. What the original meant it for is not recoverable. }
  Unused : Integer;
asm
  PUSH VirtScrSeg
  PUSH 0
  CALL ClearScreen
  PUSH DS                { DS is about to be the triangle list    }
  MOV  DX, VirtScrSeg    { kept in DX for the whole loop          }
  MOV  CX, 782h          { 1922 triangles                         }
  LDS  SI, Tris
  LES  DI, Verts
  MOV  BX, DI            { BX := the base of the vertex array     }
@Tri:
  PUSHA                  { 186: save everything, SI included      }
  LODSW                  { the first vertex index                 }
  MOV  DI, AX
  SHL  AX, 2             { I*4                                    }
  ADD  DI, AX            { + I = I*5, the record size           }
  ADD  DI, BX
  MOV  AX, ES:[DI]       { SX                                     }
  PUSH AX
  ADD  DI, 2
  MOV  AX, ES:[DI]       { SY                                     }
  PUSH AX
  LODSW                  { the second vertex                      }
  MOV  DI, AX
  SHL  AX, 2
  ADD  DI, AX
  ADD  DI, BX
  MOV  AX, ES:[DI]
  PUSH AX
  ADD  DI, 2
  MOV  AX, ES:[DI]
  PUSH AX
  LODSW                  { the third vertex                       }
  MOV  DI, AX
  SHL  AX, 2
  ADD  DI, AX
  ADD  DI, BX
  MOV  AX, ES:[DI]
  PUSH AX
  ADD  DI, 2
  MOV  AX, ES:[DI]
  PUSH AX
  INC  DI                { now at +3 of the third vertex          }
  MOV  AX, ES:[DI]       { a WORD read spanning +3 and +4         }
  MOV  AL, AH            { and only the high half is the colour   }
  XOR  AH, AH
  PUSH AX
  PUSH DX                { the destination segment                }
  CALL FillTriangle
  POPA                   { which puts SI back where it was        }
  ADD  SI, 6             { so step it over the three indices here }
  DEC  CX
  JNZ  @Tri
  POP  DS
  PUSH VirtScrSeg
  PUSH 0A000h
  CALL CopyScreen
end;

{ colours 1..45 get a blue ramp from 20 to 64. }

{ --------------------------------------------------------------------------
sweep the threshold down from A to B and back up again,
  redrawing the mesh at every step. Both loops are guarded, so an inverted
  pair simply does nothing.
  -------------------------------------------------------------------------- }
procedure Morph(A, B : Byte);
{ T IS A WORD. Both guards are UNSIGNED in the original -- 100e:06c2 is JB and
 is JA -- and an Integer counter gives JL and JG over the same
  zero-extended byte compares. Two bytes, and no behaviour: A and B are Bytes,
  so neither value can reach the range where the two disagree. }
var T : Word;
begin
  for T := A downto B do                         { JB guard }
  begin
    HeightFromMap(T);
    Project(@Grid, @Proj);
    DrawMesh(@Proj, @MeshTris);
  end;
  for T := B to A do                             { JA guard }
  begin
    HeightFromMap(T);
    Project(@Grid, @Proj);
    DrawMesh(@Proj, @MeshTris);
  end;
end;

{ colours 1..45 get a blue ramp from 20 to 64. }
procedure BuildRamp;
var I : Byte;
begin
  for I := $1E to $4A do SetRGB(I - $1D, 0, 0, I - $0A);
end;

{ bring colour 1 up out of black, a step every 50 ms. }

{ bring colour 1 up out of black, a step every 50 ms. }
procedure FadeUpDot;
var I : Byte;
begin
  for I := 1 to $14 do
  begin
    SetRGB(1, 0, 0, I);
    Delay($32);
  end;
end;

{ --------------------------------------------------------------------------
the scene.

  ASSETS  NEUROSIS.DAT $00153DE5, three 1024-byte greyscale height maps read
          back to back, each 32 x 32.
  -------------------------------------------------------------------------- }
procedure Scene1;
begin
  Assign(F, 'neurosis.dat');
  Reset(F, 1);
  Seek(F, DataOfs);

  SetRGB(1, 0, 0, 0);                            { start black }
  BuildGrid;
  BuildRowTable;

  { the map is still all zeroes here, so every point comes out at
    the base plane. This is what makes the first frame a flat sheet. }
  HeightFromMap($37);
  Project(@Grid, @Proj);
  DrawMesh(@Proj, @MeshTris);

  FadeUpDot;
  BuildRamp;

  BlockRead(F, HeightMap, MapSize);
  Morph($41, $14);
  BlockRead(F, HeightMap, MapSize);
  Morph($41, $14);
  BlockRead(F, HeightMap, MapSize);
  Morph($37, $05);

  ClearScreen($A000, 0);
  Close(F);
end;

