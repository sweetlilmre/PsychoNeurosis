program TP1S2;

uses Crt, VGA, DemoVT, P1S2;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TP1S2: neurosis.dat not found in the current directory.');
    WriteLn('       Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 001 scene 2 -- "ASPHYXIA PRESENTS" and the comet');
  WriteLn('Press a key to start.');
  ReadKey;

  SetMode13h;
  VirtScrAlloc;
  MusicInit;          { harmless with no player resident }
  Scene2;

  VirtScrFree;
  SetTextMode;

  WriteLn('Done.');
end.
