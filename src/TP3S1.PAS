program TP3S1;

uses Crt, VGA, DemoVT, Part3Tunnel;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TP3S1: neurosis.dat not found in the current directory.');
    WriteLn('       Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 003 scene 1 -- the tunnel');
  WriteLn('Press a key to start.');
  ReadKey;

  SetMode13h;
  VirtScrAlloc;
  MusicInit;          { harmless with no player resident }
  Scene1;

  VirtScrFree;
  SetTextMode;

  WriteLn('Done.');
end.
