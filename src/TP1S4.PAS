{ ===========================================================================
  Test harness for part 001 scene 4 -- rotating 3-D text.

  One scene on its own: if it misbehaves the fault is in P1S4 or in the VGA
  unit beneath it, and nowhere else. Generated by tools/mktests.py -- do not
  edit; change the generator instead.

  Needs NEUROSIS.DAT in the current directory, so run it from run\.

  Build:  python tools/dosbox/dosbuild.py TP1S4
  =========================================================================== }

program TP1S4;

uses Crt, VGA, DemoVT, P1S4;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TP1S4: neurosis.dat not found in the current directory.');
    WriteLn('          Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 001 scene 4 -- rotating 3-D text');
  WriteLn('Press a key to start, and any key again to stop.');
  ReadKey;

  SetMode13h;
  VirtScrAlloc;
  MusicInit;          { harmless with no player resident }

  Scene4;

  VirtScrFree;
  SetTextMode;
  WriteLn('Done.');
end.
