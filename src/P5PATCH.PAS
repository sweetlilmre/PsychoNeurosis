{ ===========================================================================
  Psycho Neurosis (Asphyxia, 1994) -- NEUROSIS.005 scene 3, segment 1102.

  A 30 x 30 patch of a loaded picture, lifted into three dimensions and turned
  about one axis while the patch itself wanders around the picture and bounces
  off its edges. Each point is drawn in its own colour, and the pixel VALUE is
  added to the projected Y -- so the brighter a pixel, the further down the
  screen it lands, and the picture becomes a relief.

  Read from the binary instruction by instruction; nothing here is inferred.
  See docs/26-part5-notes.md for the reading.

  [re] ADDRESS MAP
    RenderPatch     1102:0000     Demo_Scene3     1102:035a
    Scene3_Run      1102:017e     (unit init)     1102:038c
    Setup           1102:02d1
    FixMul          1102:0391     SinCos          1102:11d9
    FixDiv          1102:03a5     RotatePoint     1102:128b
    the cosine table at CS:$03C5   Project         1102:13d9

  THE MATHS IS THE SAME OBJECT PARTS 001 AND 002 LINK. `SinCos`,
  `RotatePoint` and `Project` here are byte-identical to part 001's copies at
  1107:1804, 1107:18b6 and 1107:1a04 -- 16, 24 and 7 bytes differ across the
  three and every one of them is a DGROUP or table displacement. The table at
  CS:$03C5 is the same 901 entries of Round(cos(i/10 degrees) * 65536).

  The module has FIVE routines and not three. FixMul and FixDiv sit ahead of
  the table, and neither is called from Pascal in any part read so far -- they
  survive the link because an external OBJ is linked whole rather than per
  procedure. They are part of the module and are in src/asm/DEMOMATH.ASM.

  [re] FixMul at 1102:0391 and FixDiv at 1102:03a5, in both binaries.

  [re] DGROUP
    DS:$a662  MCos1   DS:$a666  MSin1        DS:$a67a  MScale
    DS:$a66a  MCos2   DS:$a66e  MSin2        DS:$a67e  the picture, a Pointer
    DS:$a672  MCos3   DS:$a676  MSin3        DS:$a682  its segment
    DS:$a684  the palette, 768 bytes         DS:$a984  the file
    DS:$2d16  MViewH = 200   DS:$2d18  MViewW = 320  -- initialised data
  =========================================================================== }

{$S-}   { 1102:0000 opens ENTER $26,0 with no stack check. }

unit P5PATCH;
{$I-}   { no I/O check: the original goes straight on after each file
          call, with no near CALL to the RTL's check routine. }
{$A-}   { data alignment off -- measured, see the note in P2SOLID.PAS }

{ 286 instructions are permitted. }
{$G+}   { [re] RenderPatch 1102:0000 opens ENTER $26; the whole segment is
          ENTER-framed. }

interface

procedure Scene3;

implementation

uses Crt, VGA, FixMath;

{ Where each asset sits inside NEUROSIS.DAT. Untyped constants, so including
  the whole set costs no storage. }
{$I gen/DATOFS.INC}   { [re] NEUROSIS.DAT offsets and lengths, generated by
                        tools/mkdat.py from assets/NEUROSIS.MAN. Every
                        constant in it is UNTYPED, so including the whole
                        set costs no storage and changes no data image. }

const
  Patch    = 30;                  { 1102:0004 -- the patch is 30 x 30 }
  DataOfs  = DAT_P5_PATCHPIC;   { where this scene's picture starts }
  ScaleR   = 1600.0;              { 1102:035d builds this Real in AX:BX:DX }
  DepthZ   = 200;                 { 1102:00f6 }
  LiftY    = -50;                 { 1102:00d7 pushes -$32 }
  YBias    = 500;                 { 1102:012f subtracts $1F4 }
  FullTurn = 3600;                { tenths of a degree }

type
  TPal768 = array[0..767] of Byte;
  { 1102:011f and 1102:012c subtract using AX alone, so only the LOW word of
    the projected coordinate is ever looked at. }
  TLongRec = record Lo, Hi : Word end;

var
  { The six words the maths module reads, in the order the binary has them --
    the ANGLE goes into the SECOND pair and the other two are zeroed.

    [re] 1102:0025 fills the pair at $a662 and 1102:0022 the pair at $a66a. }
  MCos1, MSin1, MCos2, MSin2, MCos3, MSin3 : LongInt;
  MScale : LongInt;                       { DS:$a67a }

  Pic    : Pointer;                       { DS:$a67e }
  PicSeg : Word;                          { DS:$a682 }
  Pal    : TPal768;                       { DS:$a684 }
  F      : file;                          { DS:$a984 }

const
  { DS:$2d16 and DS:$2d18, initialised data. Project halves both, so these are
    the FULL view size and not the centre.

    DECLARED H FIRST, and the addresses are the whole reason: the original
    puts MViewH at $2d16 and MViewW at $2d18, so W-then-H transposes them.
    They cannot move to P5MESH either -- DEMOMATH.OBJ's EXTRN resolves by
    Pascal scope in the unit that links it, and declaring them there gives
    `Undefined external (MViewW)`. }
  MViewH : Word = 200;
  MViewW : Word = 320;

{$L DEMOMATH.OBJ}
{ [re] 19 bytes and then a NOP, which pads FixDiv up to 1102:03a5. The pad is
  the assembler aligning the next PROC, not part of the routine.
  [re] @asm 005 1102:0391 +19 FixMul }
procedure FixMul(A, B : LongInt);                         external;
{ [re] @asm 005 1102:03a5 +32 FixDiv }
procedure FixDiv(A, B : LongInt);                         external;
{ [re] @asm 005 1102:11d9 +178 SinCos5 }
procedure SinCos(A : Integer; var C, S : LongInt);        external;
{ [re] @asm 005 1102:128b +334 RotatePoint5 }
procedure RotatePoint(var X, Y, Z : LongInt);             external;
{ [re] @asm 005 1102:13d9 +166 Project5 }
procedure Project(var X, Y, Z : LongInt);                 external;

{ --------------------------------------------------------------------------
  one frame of the patch.

  (CX, CY) is where the patch sits in the picture; Angle is in tenths of a
  degree. Every one of the 900 points is read out of the picture, turned, and
  plotted -- there is no mesh and no interpolation, so what you see is 900
  loose pixels.

  Two details that are easy to get wrong by inference. The patch coordinate is
  used TWICE and differently: `Col - 15` picks the pixel out of the picture
  when added to CX, and the SAME `Col - 15` is the 3-D X. And the height is
  not applied in three dimensions at all -- Y is the constant -50 going in,
  and the pixel value is added to the PROJECTED Y, after the divide.
  -------------------------------------------------------------------------- }
{ EIGHT BYTES OF PARAMETERS -- four words, not three plus a LongInt. So the
  ANGLE is two bytes here, which is what SinCos takes anyway.

  [re] 1102:017b is `RET 8` and this build was emitting `RET $0A`. Dropping
  Seg_ instead was tried and measured 13 bytes WORSE, because the pixel read
  through the parameter had been matching all along. }
{ THE PARAMETERS ARE PX AND PY, NOT CX AND CY, and the reason is the asm block
  below: inside BASM `CX` is a REGISTER, so `MOV AX, CX` would assemble as the
  register move and not the parameter load, silently. The caller's own variables
  keep their names -- only these two are renamed, and only because they are read
  from assembler. }
procedure RenderPatch(PX, PY : Integer; Angle : Integer; Seg_ : Word);
var
  { DECLARATION ORDER IS FRAME ORDER, and this block is in the original's.
    Locals go downward from BP as they are declared, so moving any of these
    moves every one below it.

    [re] Sorting the recorded offsets ascending recovers the original's var
    block. Size and Half were declared first and took the slots nearest BP,
    which pushed X, Y and Z down four bytes each -- and the three pointers
    pushed for Project are where this part's largest span begins. }
  { THE TWO SLOTS AT THE BOTTOM ARE NOT DECLARATIONS AT ALL -- they are the
    two `for` loops' upper bounds, each evaluated once into a temporary because
    neither limit is constant. Declaring LimY and LimX as variables produces
    both the variables AND the temporaries, which is four bytes too many.

    [re] 1102:0004 puts Size at [BP-$1B] and Pixel is at [BP-$11], so nine
    bytes sit between them; [BP-$23] and [BP-$25] are the temporaries.
    1102:0043 copies Size into [BP-$23] and 1102:004c compares against that
    slot every iteration, which is store-then-compare.

    [re] On the earlier reading -- SX and SY in the nine, leaving four spare --
    the arithmetic closed on the odd offset Size sits at: Pixel is one byte at
    [BP-$11], SX and SY take [BP-$13] and [BP-$15], four spare bytes take
    [BP-$19]..[BP-$16], and Size then lands at [BP-$1B]. That odd offset is the
    check, because only a one-byte local above it can produce one; five spare
    bytes put it at [BP-$1C] and every reference below it a byte out.
    2+2+4+4+4+1 + 2+2+4 + 2+2+2+2 is 33, plus the two temporaries is 37, and
    Turbo Pascal rounds that up to 38 = $26. The block is now read as eight
    dead bytes rather than SX, SY and four spare -- see below -- which changes
    none of these totals. }
  Col, Row       : Integer;       { [BP-$02], [BP-$04] }
  X, Y, Z        : LongInt;       { [BP-$08], [BP-$0C], [BP-$10] }
  Pixel          : Byte;          { [BP-$11] }
  { EIGHT SPARE BYTES, AND THEY ARE ONE DEAD BLOCK. There are no SX and SY
    variables here: the clip-and-sample below is hand assembler and holds both
    coordinates in registers.

    [re] The nine unaccounted bytes were read as "SX and SY live here plus four
    spare", which is arithmetically the same and wrong about what they are.
    [BP-$12]..[BP-$19] is the dead block; the frame total, the odd offset Size
    sits at, and every reference below it are all unchanged. }
  Spare          : array[1..8] of Byte;   { [BP-$19]..[BP-$12], never read }
  Size, Half     : Integer;       { [BP-$1B], [BP-$1D] }
  ScreenX        : Integer;       { [BP-$1F] }
  ScreenY        : Integer;       { [BP-$21] }
  { the two slots below this are the compiler's, not ours }
begin
  Size := Patch;                                 { 1102:0004 }
  Half := Size div 2;                            { 1102:0010 }

  SinCos(Angle, MCos2, MSin2);                   { 1102:0022 -- the only turn }
  SinCos(0, MCos1, MSin1);                       { 1102:0031 }
  SinCos(0, MCos3, MSin3);                       { 1102:0040 }

  for Row := 1 to Size do                        { 1102:0043 }
  begin
    for Col := 1 to Size do                      { 1102:005c }
    begin
      Pixel := 0;                                { 1102:0075 }
      { ----------------------------------------------------------------------
        1102:0079..00b2 -- clip the source point and sample it. HAND ASSEMBLER,
        transcribed verbatim, and THREE tells say so independently:

          [re] * BOTH COORDINATES LIVE IN REGISTERS ACROSS FOUR TESTS WITH NO
            STORE. AX holds the column sum from 007f to 00a6 and BX the row sum from
            0092 to 00a2, each compared twice and then USED. Turbo Pascal frames
            every local, so a Pascal `SX` is written before it is tested and read
            back for each comparison -- which is what ours did, seven bytes and
            two dead frame slots' worth.
          * 1102:00a0 is ADD BX,BX where the compiler emits SHL BX,1. That is
            this target's recorded assembler idiom for a doubling.
          * 1102:0087 is 3D 00 00 -- CMP AX,0 in the LONG immediate form -- and
            1102:009b is 83 FB 00, the SHORT form of the same operation, twenty
            bytes apart. A code generator picks one rule and keeps it; the
            INCONSISTENCY is the signature, the same way part 003's morph scene
            uses JE/JMP five times and then plain JNE three times.

        And ours was wrong in a way that mattered beyond the byte count: with
        YOfs a Word array and SX an Integer, `YOfs[SY] + SX` promotes to LONGINT,
        so ours computed the screen offset in 32 bits (CWD, a CX:BX pair) where
        the original's ADD DI,AX is 16.

        EQUIVALENT PASCAL, for reference -- the assembler below is what runs:

            SX := PX + Col - Half;
            if (SX <= 319) and (SX >= 0) then
            begin
              SY := PY + Row - Half;
              if (SY <= 199) and (SY >= 0) then
                Pixel := Mem[Seg_ : YOfs[SY] + SX];
            end;
        ---------------------------------------------------------------------- }
      asm
              MOV     AX, PX                  { 1102:0079                     }
              ADD     AX, Col                 { 007c                          }
              SUB     AX, Half                { 007f  AX := the column, kept  }
              CMP     AX, 319                 { 0082                          }
              JG      @@Skip                  { 0085                          }
              CMP     AX, 0                   { 0087  the LONG form           }
              JL      @@Skip                  { 008a                          }
              MOV     BX, PY                  { 008c                          }
              ADD     BX, Row                 { 008f                          }
              SUB     BX, Half                { 0092  BX := the row, kept     }
              CMP     BX, 199                 { 0095                          }
              JG      @@Skip                  { 0099                          }
              CMP     BX, 0                   { 009b  and the SHORT form      }
              JL      @@Skip                  { 009e                          }
              ADD     BX, BX                  { 00a0  a word index            }
              MOV     DI, [BX + OFFSET YOfs]  { 00a2  DI := Row * 320         }
              ADD     DI, AX                  { 00a6    + the column, 16-bit  }
              MOV     AX, Seg_                { 00a8                          }
              MOV     ES, AX                  { 00ab                          }
              MOV     AL, ES:[DI]             { 00ad  the source pixel        }
              MOV     Pixel, AL               { 00b0                          }
      @@Skip:                                 { 00b3 is the next statement    }
      end;

      X := IntToFixed(Col - Half);               { 1102:00ba }
      Z := IntToFixed(Row - Half);               { 1102:00cc }
      Y := IntToFixed(LiftY);                    { 1102:00d9 }
      RotatePoint(X, Y, Z);                      { 1102:00f3 }
      Z := Z + IntToFixed(DepthZ);               { 1102:0101 }
      Project(X, Y, Z);                          { 1102:0119 }

      ScreenX := 320 - Integer(TLongRec(X).Lo);            { 1102:011c }
      ScreenY := Integer(TLongRec(Y).Lo) - YBias + Pixel;  { 1102:012c }

      if (ScreenX > 0) and (ScreenX < 319) and   { 1102:0137, 1102:013d }
         (ScreenY > 0) and (ScreenY < 199) then  { 1102:0144, 1102:014a }
        PutPixel(ScreenX, ScreenY, Pixel, VirtScrSeg);   { 1102:015f }
    end;
  end;
end;

{ --------------------------------------------------------------------------
  the frame loop.

  The patch wanders diagonally at two pixels a frame and reflects off all four
  edges of the picture. At frame 100 it stops moving and the rotation jumps to
  three degrees a frame; at 220 it starts moving again and the rotation drops
  back to one degree. From frame 500 the palette dims a step each frame, and
  at 564 it stops. A keypress jumps the frame count straight to 500, so the
  fade-out is what a key buys you.
  -------------------------------------------------------------------------- }
procedure Run;
var
  { IN THE ORDER THE RECORDED OFFSETS GIVE -- $2, $4, $6, $8, $A, $C, $E, then
    the Boolean at $F, which is why Running goes LAST and not first. Seven
    words and a byte is fifteen, and the frame is ENTER $10.

    ANGLE IS TWO BYTES, not a LongInt -- which agrees with RenderPatch, whose
    eight bytes of parameters leave room for exactly two.

    [re] DY_ is at [BP-8] and Angle at [BP-$0A], so there is no room, and
    1102:0190 zeroes it with a single word store. }
  CX, CY   : Integer;             { [BP-2], [BP-4] }
  DX_, DY_ : Integer;             { [BP-6], [BP-8] }
  { A WORD, NOT AN INTEGER, and AngStep beside it is signed -- so the `mod`
    that follows is a 32-bit divide of a mixed sum rather than a plain one.

    [re] 1102:022d is XOR DX,DX on
    [BP-$0A] where 1102:0225 is CWD on [BP-$0C] -- unsigned against signed, in
    the same expression, two instructions apart. So Angle is a Word and AngStep
    an Integer, and the `mod` that follows is a 32-bit divide of the mixed sum.

    THE OPERAND ORDER FOLLOWS FROM IT TOO. The Integer is the one PARKED in
    CX:BX and the Word is the one left in AX:DX, so the parked one is written
    SECOND: the source is `Angle + AngStep` and not the other way round. }
  Angle    : Word;                { [BP-$0A] }
  AngStep  : Integer;             { [BP-$0C] }
  { A WORD, NOT AN INTEGER, so the two comparisons below are unsigned. It
    makes no difference to behaviour -- Frame runs 0..564 and never goes
    negative -- but it is a different branch instruction either way.

    [re] 1102:01f5 and 1102:0210 are
    JB where a signed compare gives JL -- the same two bytes with the wrong
    condition -- so `Frame >= 500` and `Frame >= 564` are UNSIGNED comparisons
    and Frame is unsigned. Nothing else about the routine changes: Frame runs
    0..564 and never goes negative, so the two forms behave identically here and
    only the 1994 bytes say which was written. }
  Frame    : Word;                { [BP-$0E] }
  Running  : Boolean;             { [BP-$0F] }
begin
  Running := True;                               { 1102:0182 }
  CX      := 160;                                { 1102:0186 }
  CY      := 100;                                { 1102:018b }
  Angle   := 0;                                  { 1102:0190 }
  AngStep := 0;                                  { 1102:0195 }
  Frame   := 0;                                  { 1102:019a }
  DX_     := 2;                                  { 1102:019f }
  DY_     := 2;                                  { 1102:01a4 }
  repeat
    { 1102:01a9 -- the test is in the binary and is redundant: the loop only
      goes round again while Running is set. Transcribed as it stands. }
    if Running then Inc(Frame);

    if KeyPressed then                           { 1102:01b2 }
    begin
      Frame := 500;                              { 1102:01bb }
      ReadKey;                                   { 1102:01c0 }
    end;
    if Frame = 100 then                          { 1102:01c5 }
    begin
      DX_ := 0;  DY_ := 0;  AngStep := 30;       { 1102:01cb }
    end;
    if Frame = 220 then                          { 1102:01da }
    begin
      DX_ := 2;  DY_ := 2;  AngStep := 10;       { 1102:01e1 }
    end;
    if Frame >= 500 then                         { 1102:01f0 }
    begin
      PaletteDim(@Pal);                          { 1102:01fc }
      SetPalette768(@Pal);                       { 1102:0206 }
    end;
    if Frame >= 564 then Running := False;       { 1102:020b }

    { `Inc`, NOT AN ASSIGNMENT -- and it is the opposite way round from
      P1LOGO, so the rule is per site rather than per unit. `Inc` adds straight
      into memory; `CX := CX + DX_` loads, adds and stores back.

      [re] The original is MOV AX,[BP-6] / ADD [BP-2],AX -- six bytes, the
      addend loaded
      and added straight into memory -- where `CX := CX + DX_` loads CX first,
      adds, and stores back: nine. Three bytes each, six across the pair, and
      that was the whole of this unit's excess.

      P1LOGO's two bouncer updates went the other way: there the ORIGINAL wrote
      the assignment and recomputed the subscript three times, and Inc was the
      shorter form we had to give up. The ADD's operand direction names which
      was written -- ADD [mem],reg is Inc, ADD reg,[mem] with a store after is
      the assignment -- and it has now been read in both directions in one
      corpus. }
    Inc(CX, DX_);                                { 1102:0216 }
    Inc(CY, DY_);                                { 1102:021c }
    Angle := (Angle + AngStep) mod FullTurn;     { 1102:0222 }

    if CX < 0   then begin CX := 0;   DX_ := -DX_ end;   { 1102:0244 }
    if CX > 319 then begin CX := 319; DX_ := -DX_ end;   { 1102:0257 }
    if CY < 0   then begin CY := 0;   DY_ := -DY_ end;   { 1102:026b }
    if CY > 199 then begin CY := 199; DY_ := -DY_ end;   { 1102:0283 }

    ClearScreen(VirtScrSeg, 0);                  { 1102:0298 }
    RenderPatch(CX, CY, Angle, PicSeg);          { 1102:02aa }
    CopyScreen(VirtScrSeg, $A000);               { 1102:02b4 }
  until not Running;                             { 1102:02b9 }
end;

{ --------------------------------------------------------------------------
  the picture and its palette.

  ASSETS  NEUROSIS.DAT $001646E5:
            64,000 bytes  a 320 x 200 picture
            768 bytes     its palette
  -------------------------------------------------------------------------- }
procedure Setup;
var
  { 130 BYTES OF FRAME AND NOT ONE OF THEM IS REFERENCED. The routine touches
    no local at all in its whole body, so this is pure declaration -- a file
    record and one more word, which is what part 005's and part 006's other
    scenes declare and leave unopened in the same position. The file this
    routine actually uses is the unit-level global.

    [re] ENTER $82 is 130 bytes and the routine touches no [BP-n] slot at any
    width. Ours had no frame at all.

    [re] 128 + 2 is a file record and one more word. P6WHOOSH's Load,
    P6TILES's Setup and P6CREDIT's Setup all do the same. The global the
    routine really uses is at DS:$A984, which 1102:02ed pushes.

    The TYPES are a guess and only the total is measured. }
  Unread : file;                  { [BP-$80]..[BP-1], never referenced }
  Spare  : Integer;               { [BP-$82], never referenced }
begin
  GetMem(Pic, 64000);                            { 1102:02d5 }
  PicSeg := Seg(Pic^);                           { 1102:02e4 }
  Assign(F, 'neurosis.dat');                     { 1102:02f7 }
  Reset(F, 1);
  Seek(F, DataOfs);
  BlockRead(F, Pic^, 64000);                     { 1102:0329 }
  BlockRead(F, Pal, SizeOf(Pal));                { 1102:033f }
  Close(F);                                      { 1102:0349 }
  SetPalette768(@Pal);                           { 1102:0353 }
end;

{ 1102:035a -- the scene. }
procedure Scene3;
begin
  MScale := RealToFixed(ScaleR);                 { 1102:035d -- 1600.0 }
  Setup;                                         { 1102:0374 }
  Run;                                           { 1102:0377 }
  FreeMem(Pic, 64000);                           { 1102:0385 }
end;

{ 1102:038c -- the unit's initialisation is empty. }
begin
end.
