{ ===========================================================================
  Test harness for part 006 -- all four scenes, through the main body at 1000:002d.

  Generated by tools/mktests.py -- do not edit; change the generator instead.
  Needs NEUROSIS.DAT in the current directory, so run it from run\.

  Build:  python tools/dosbox/dosbuild.py TPART6
  =========================================================================== }

program TPART6;

{ No $E- here, deliberately: the _fpu originals' raw 9B+ESC x87 encodings
  are a post-build PATCH of the CD 3x emulator interrupts TP7 always emits
  -- the two variants are byte-identical apart from exactly those pairs --
  so the faithful build keeps the $E+ default. See dosbuild.py. }

uses Crt, VGA, DemoVT, P6Main;

var
  PrevExit : Pointer;

{ Runs on the way out of Halt, of a run-time error, or of a normal end --
  see the note in mktests.py. }
procedure RestoreTextMode; far;
begin
  ExitProc := PrevExit;
  asm
    MOV  AX, $0003      { BIOS mode 3: 80x25 colour text                    }
    INT  $10            { which also undoes Mode-X's CRTC and sequencer     }
  end;
end;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TPART6: neurosis.dat not found in the current directory.');
    WriteLn('        Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 006 -- all four scenes, through the main body at 1000:002d');
  WriteLn('Press a key to start.');
  ReadKey;

  PrevExit := ExitProc;
  ExitProc := @RestoreTextMode;

  RunPart6;


  WriteLn('Done.');
end.
