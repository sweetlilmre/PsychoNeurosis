program TP3S3;

uses Crt, VGA, DemoVT, Part3Morph;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TP3S3: neurosis.dat not found in the current directory.');
    WriteLn('       Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 003 scene 3 -- the morph');
  WriteLn('Press a key to start.');
  ReadKey;

  SetMode13h;
  VirtScrAlloc;
  MusicDetect;          { harmless with no player resident }
  Scene3;

  VirtScrFree;
  SetMode13h;         { 1000:0097 -- what the driver does after scene 3 }
  SetTextMode;

  WriteLn('Done.');
end.
