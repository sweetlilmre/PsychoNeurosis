{ ===========================================================================
  Test harness for part 003 scene 1 -- the tunnel.

  One scene on its own: if it misbehaves the fault is in P3TUNNEL or in the VGA
  unit beneath it, and nowhere else. Generated by tools/mktests.py -- do not
  edit; change the generator instead.

  Needs NEUROSIS.DAT in the current directory, so run it from run\.

  Build:  python tools/dosbox/dosbuild.py TP3TUN
  =========================================================================== }

program TP3TUN;

uses Crt, VGA, DemoVT, P3TUNNEL;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TP3TUN: neurosis.dat not found in the current directory.');
    WriteLn('          Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 003 scene 1 -- the tunnel');
  WriteLn('Press a key to start, and any key again to stop.');
  ReadKey;

  SetMode13h;
  VirtScrAlloc;
  MusicInit;          { harmless with no player resident }

  Scene1;

  VirtScrFree;
  SetTextMode;
  WriteLn('Done.');
end.
