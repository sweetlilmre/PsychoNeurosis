{ ===========================================================================
  Test harness for part 006 scene 2 -- the rotating tile mesh.

  Generated by tools/mktests.py -- do not edit; change the generator instead.
  Needs NEUROSIS.DAT in the current directory, so run it from run\.

  Build:  python tools/dosbox/dosbuild.py TP6S2
  =========================================================================== }

program TP6S2;

uses Crt, VGA, DemoVT, P6S2;

var
  PrevExit : Pointer;

{ Runs on the way out of Halt, of a run-time error, or of a normal end --
  see the note in mktests.py. }
procedure RestoreTextMode; far;
begin
  ExitProc := PrevExit;
  asm
    MOV  AX, $0003      { BIOS mode 3: 80x25 colour text                    }
    INT  $10            { which also undoes Mode-X's CRTC and sequencer     }
  end;
end;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TP6S2: neurosis.dat not found in the current directory.');
    WriteLn('       Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 006 scene 2 -- the rotating tile mesh');
  WriteLn('Press a key to start.');
  ReadKey;

  PrevExit := ExitProc;
  ExitProc := @RestoreTextMode;

  SetMode13h;         { 1000:0030 }
  VirtScrAlloc;       { 1000:0035 }
  Scene2;

  VirtScrFree;        { 1000:00cd }

  WriteLn('Done.');
end.
