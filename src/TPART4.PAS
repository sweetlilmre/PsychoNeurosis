  Test harness for part 004 -- the lemmings; single-scene, the harness stands in for the driver.

  Generated by tools/mktests.py -- do not edit; change the generator instead.
  Needs NEUROSIS.DAT in the current directory, so run it from run\.

  Build:  python tools/dosbox/dosbuild.py TPART4
  =========================================================================== }

program TPART4;

uses Crt, VGA, DemoVT, Part4Lemmings;

var
  PrevExit : Pointer;

{ Runs on the way out of Halt, of a run-time error, or of a normal end --
  see the note in mktests.py. }
procedure RestoreTextMode; far;
begin
  ExitProc := PrevExit;
  asm
    MOV  AX, $0003      { BIOS mode 3: 80x25 colour text                    }
    INT  $10            { which also undoes Mode-X's CRTC and sequencer     }
  end;
end;

var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TPART4: neurosis.dat not found in the current directory.');
    WriteLn('        Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);

  WriteLn('part 004 -- the lemmings; single-scene, the harness stands in for the driver');
  WriteLn('Press a key to start.');
  ReadKey;

  PrevExit := ExitProc;
  ExitProc := @RestoreTextMode;

  SetMode13h;         { 1000:001c -- part 004 sets its own mode }
  VirtScrAlloc;       { 1000:0021 -- the hillside lives here }
  RunPart4;

  while KeyPressed do ReadKey;   { 1000:002b }
  VirtScrFree;                  { 1000:003b }

  WriteLn('Done.');
end.
