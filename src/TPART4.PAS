{ ===========================================================================
  Test harness for part 004 -- the lemmings; single-scene, the harness stands in for the driver.

  Generated by tools/mktests.py -- do not edit; change the generator instead.
  Needs NEUROSIS.DAT in the current directory, so run it from run\.

  Build:  python tools/dosbox/dosbuild.py TPART4
  =========================================================================== }

program TPART4;

{ No $E- here, deliberately: the _fpu originals' raw 9B+ESC x87 encodings
  are a post-build PATCH of the CD 3x emulator interrupts TP7 always emits
  -- the two variants are byte-identical apart from exactly those pairs --
  so the faithful build keeps the $E+ default. See dosbuild.py. }

uses Crt, VGA, DemoVT, Part4Lemmings;

var
  PrevExit : Pointer;

{ Runs on the way out of Halt, of a run-time error, or of a normal end --
  see the note in mktests.py. }
procedure RestoreTextMode; far;
begin
  ExitProc := PrevExit;
  asm
    MOV  AX, $0003      { BIOS mode 3: 80x25 colour text                    }
    INT  $10            { which also undoes Mode-X's CRTC and sequencer     }
  end;
end;

{ F IS A LOCAL, NOT A GLOBAL, and the reason is a measurement rather than
  tidiness. A program's own variables land at the FRONT of DGROUP's
  uninitialised region, ahead of every unit's, so a 128-byte file record here
  pushed the part's first variable 128 bytes late and carried every absolute
  reference in the whole part with it: ColOfs sat at $01F6 where the original
  has $0172.

  THE REMAINING FOUR BYTES ARE NOT PrevExit, which is what the first version of
  this note said. ColOfs is at $0176 now, and it stays at $0176 with PrevExit
  removed altogether and the exit hook with it -- tried, measured, reverted. So
  128 of the 132 were this record and the last four are somebody else's.

  A HARNESS DISPLACES THE PART IT MEASURES, and that is worth knowing wherever
  these are generated: any global the harness declares moves every variable in
  the part under test, so the coverage number is partly a measurement of the
  measuring apparatus. }
procedure CheckData;
var
  F : file;
begin
  Assign(F, 'neurosis.dat');
  {$I-} Reset(F, 1); {$I+}
  if IOResult <> 0 then
  begin
    WriteLn('TPART4: neurosis.dat not found in the current directory.');
    WriteLn('        Run this from the run\ folder.');
    Halt(1);
  end;
  Close(F);
end;

begin
  CheckData;
  WriteLn('part 004 -- the lemmings; single-scene, the harness stands in for the driver');
  WriteLn('Press a key to start.');
  ReadKey;

  PrevExit := ExitProc;
  ExitProc := @RestoreTextMode;

  SetMode13h;         { 1000:001c -- part 004 sets its own mode }
  VirtScrAlloc;       { 1000:0021 -- the hillside lives here }
  RunPart4;

  while KeyPressed do ReadKey;   { 1000:002b }
  VirtScrFree;                  { 1000:003b }

  WriteLn('Done.');
end.
