# Compiler scratch. dosbuild.py wipes this at the start of every invocation,
# so nothing here survives a build of anything else.
build/

# A writable copy of bin/ plus the built harnesses. Reproduce it with
#   cp bin/* run/   and a build; dosbuild.py installs the .EXEs into it.
run/

# The Ghidra project -- 53 MB, holds live .lock files, and is rebuilt by
# importing work/split/*.exe. The analysis itself lives in docs/ and src/.
work/ghidra/

__pycache__/
*.pyc
*.bak

# Local tooling config -- machine-specific paths, not part of the project.
.mcp.json
.claude/

# ---------------------------------------------------------------------------
# NEUROSIS.008 is NOT Asphyxia code. It is JCAB / VangeliSTeam's DemoVT v1.31,
# a third-party mod player that Psycho Neurosis shells out to. Its unpacked
# image lives here because this is the tree that split it out of the demo.
#
# THE RECONSTRUCTION OF IT HAS MOVED and is no longer ignored -- it is its own
# tracked repository of its own -- a VangeliSTracker checkout alongside
# this one, which is also where the 1.39b source release now lives. Nothing about DemoVT is under this tree any
# more except the unpacked image below.
#
# tools/unlzexe.py is deliberately NOT excluded: it is original code about the
# LZEXE container format and contains nothing of DemoVT's.
work/unpack/

# The marker file for where to go next. A LOCAL working register: it holds
# real local paths and a running status that is nobody's deliverable, so it
# is not tracked. Its history up to 19 Aug 2026 is in the log as
# docs/24-continuation.md.
docs/continuation.md

# uv virtual environment for the knowledge-base tooling.
.venv/

# The kit's machine-specific answers: real local paths, so never committed --
# the same rule that keeps docs/continuation.md out. kit.toml holds the
# relative ones and IS committed.
kit.local.toml

# codegen.py's output. probe/*.PAS is the record -- a probe is a measurement
# and belongs in the repository -- but the .TPU it compiles to is build output
# and was swept in by a `git add probe/` on 24 Aug.
probe/out/

# DOSBox-X screen captures -- run artefacts, never deliverables
tools/dosbox/capture/

# The packaged demo, assembled by tools/package.py from run/ and assets/.
# Every byte of it is either built here or copied from bin/, so it is output
# and not source -- and it holds NEUROSIS.008, which is third-party.
dist/

# The DOSBox mounts overlay, generated by build.py --interactive from
# kit.local.toml. It is nothing BUT machine paths, which is exactly why the
# hand-tuned interactive.conf beside it can stay committed.
tools/dosbox/MOUNTS.CFG
tools/dosbox/*.bak

# The interactive launcher. It holds this machine's paths deliberately -- the
# emulator's directory and this checkout's -- which is exactly why it is not
# tracked. It was, with those paths in it, until 28 Aug 2026.
run.bat

# A DOSBox config written by following the README's TL;DR. It carries the host
# path of wherever the demo was copied to, so it is nobody else's.
psycho.conf
